{
  "name": "pebble-super-productivity",
  "version": "0.6.11",
  "description": "Pebble/PebbleOS watchapp that syncs tasks with Super Productivity's SuperSync server",
  "author": "BW",
  "private": true,
  "keywords": ["pebble-app"],
  "scripts": {
    "test": "node scripts/test-crypto.js && node scripts/test-argon2.js && node scripts/test-task-store.js"
  },
  "dependencies": {},
  "pebble": {
    "displayName": "Super Productivity",
    "uuid": "e9d1f6cd-ca0e-4f09-877e-de9ebbaaac49",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery"
    ],
    "watchapp": {
      "watchface": false
    },
    "projectType": "native",
    "capabilities": [
      "configurable"
    ],
    "resources": {
      "media": [
        {
          "menuIcon": true,
          "type": "png",
          "name": "IMAGE_MENU_ICON",
          "file": "images/icon.png"
        },
        {
          "type": "png",
          "name": "IMAGE_LOGO_LARGE",
          "file": "images/icon-large.png"
        },
        {
          "type": "png",
          "name": "IMAGE_CHECK_WHITE",
          "file": "images/icon-check-white.png"
        },
        {
          "type": "png",
          "name": "IMAGE_HEART_CHECK",
          "file": "images/icon-heart-check.png"
        },
        {
          "type": "png",
          "name": "IMAGE_HEART_CHECK_WHITE",
          "file": "images/icon-heart-check-white.png"
        },
        {
          "type": "png",
          "name": "IMAGE_MICROPHONE",
          "file": "images/icon-mic.png"
        },
        {
          "type": "png",
          "name": "IMAGE_MICROPHONE_WHITE",
          "file": "images/icon-mic-white.png"
        }
      ]
    },
    "messageKeys": [
      "MSG_TYPE",
      "TASK_TOTAL",
      "TASK_INDEX",
      "TASK_ID",
      "TASK_TITLE",
      "TASK_DONE",
      "TASK_PROJECT",
      "TASK_DUE_MIN",
      "TASK_TIME_SPENT_MS",
      "TASK_TIME_ESTIMATE_MS",
      "TRACKED_MS",
      "STATUS_CODE",
      "STATUS_MSG",
      "HABIT_TOTAL",
      "HABIT_INDEX",
      "HABIT_ID",
      "HABIT_TITLE",
      "HABIT_DONE",
      "HABIT_VALUE",
      "HABIT_GOAL",
      "HABIT_DELTA",
      "HABITS_ENABLED",
      "ADD_TASK_ENABLED"
    ]
  }
}
